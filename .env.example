# VoltFix Root Environment Configuration
# Backend Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL="mysql://voltfix_user:voltfix_password@localhost:3306/voltfix_db"
JWT_ACCESS_SECRET=voltfix_access_jwt_super_secret_key_minimum_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=voltfix_refresh_jwt_super_secret_key_minimum_32_characters_long
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=localhost
CLOUDINARY_CLOUD_NAME=voltfix_cloud
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=sample_cloudinary_secret
ENABLE_PAYMENTS=true
LOG_LEVEL=info

# Database (Docker Compose)
MYSQL_ROOT_PASSWORD=voltfix_root_password
MYSQL_DATABASE=voltfix_db
MYSQL_USER=voltfix_user
MYSQL_PASSWORD=voltfix_password

# Frontend Variables (Vite)
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
